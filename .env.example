# EKRS RAG Service Configuration
# Copy to .env and fill in values

# Shared secret for parser↔RAG auth (must be >=32 chars)
PARSER_TOKEN=change-me-to-a-secure-random-string-32chars

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# Redis
REDIS_URL=redis://localhost:6379

# Shared storage root (parser writes JSONL here, RAG reads).
# MUST be an absolute path AND must exist at startup; service refuses to boot otherwise.
SHARED_STORAGE_PATH=/parsed_lib

# Debug mode (enables verbose logging, dev UI)
EKRS_DEBUG=false

# Qdrant collection name
COLLECTION_NAME=rag_documents

# Chunking
MAX_CHUNK_TOKENS=768

# Minimum chunks for recall gate
MIN_RECALL_CHUNKS=1

# Embedding model (bge-small for dev, bge-m3 for production)
EMBEDDING_MODEL=bge-small-en-v1.5

# bge-m3 ONNX intra-op thread count for embedding inference.
# Phase 12 Task D+ (2026-08-19 commit 1865168): 4 threads yielded ~2.5-4x
# speedup over BGEM3FlagModel's 1-thread default on a 20-core host, with
# memory steady at 4.78 GB (vs 20 GB container limit). Operators can
# scale to 8 on larger hosts or revert to 1 for BGEM3FlagModel parity /
# memory-constrained environments. Non-numeric / empty values fall back
# to the default with a warning rather than crashing ingest.
BGE_M3_INTRA_OP_THREADS=4

# bge-m3 encode sub-batch size cap. Root cause fix for the 2026-08-21
# wedge (doc 8b776a6e8eaae267, 1343-chunk OCR table doc): one giant
# session.run batch produced a ~22.5 GB attention intermediate → OOM /
# thread-pool freeze. 64 keeps every sub-batch transient ≈ 1 GB; normal
# docs (≤64 chunks) still encode in a single call. Non-numeric / < 1
# values fall back to the default with a warning.
BGE_M3_BATCH_SIZE=64

# Phase 8 T8-1: per-IP rate limit on /v1/* (default 60/min/IP, token-bucket).
# /healthz / /health / /metrics are exempt from rate limiting. Three tiers:
#   60     — unit/integration tests + production default (anti-burst)
#   6000   — local GPU bench (T5.1 status poll @1s × 14 docs ≈ 100 req/s, won't 429)
#   60000  — load test / Phase 9 live_stress_60 (effectively disable, throughput-only)
# Makefile `gpu-acceptance` target sets 6000 inline for the bench container;
# keep production default (60) in .env.
EKRS_RATE_LIMIT=60

# Ingestion lock timeout (seconds)
INGESTION_LOCK_TIMEOUT=300

# Phase 4: System Integration
LOCK_TTL_SEC=300            # Redis lock TTL in seconds (default 5 min)
MAX_ATTEMPTS=3              # Compensation retry cap per task
TASK_DB_PATH=/var/lib/ekrs/tasks.db   # SQLite path for the tasks table

# Server
HOST=0.0.0.0
PORT=8000

# Phase 5: Observability
AUDIT_LOG_PATH=audit.log            # 永久 audit.log 路径
DEBUG_LOG_PATH=logs/debug.log       # debug 日志路径 (仅 EKRS_DEBUG=true 时生效)

# Phase 5.5 D: Metrics sidecar exporter (与 RAG 主端口 8000 分离)
# PROMETHEUS_MULTIPROC_DIR: 多 worker 模式必填;单 worker 留空即可。
# 必须在 uvicorn fork 子进程前由部署层设置(部署层面的 env)。
# PROMETHEUS_MULTIPROC_DIR=/tmp/prom_multiproc
METRICS_HOST=127.0.0.1  # docker-compose overrides to 0.0.0.0 for cross-container scrape
METRICS_PORT=9090

# Phase 6A: X-Admin-Key auth (spec §16). Empty disables admin endpoints (503).
ADMIN_KEY=

# Phase 6A: parser callback URL (spec §18, already in use by ingestion flow).
ENGINE_URL=http://localhost:8000

# Phase 6A: documents metadata DB path (D8 — independent from task DB).
DOCUMENTS_DB_PATH=/var/lib/ekrs/documents.db

# Phase 6B: Auto-rebuild Qdrant collection when dense dim changes (e.g., 384d -> 1024d)
# Set to false in production to require manual intervention
AUTO_REINDEX=true
