{
  "name": "ekrs-dev-ui-v2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EKRS dev UI — React + Vite + TypeScript production-grade SPA. Replaces the Streamlit dev_ui (Phase 10 §Out of scope; Phase 11 scope doc).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc -b",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,md}\" \"*.{ts,tsx,json,md,cjs,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,md}\" \"*.{ts,tsx,json,md,cjs,mjs}\"",
    "check:bundle": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.51.23",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@typescript-eslint/eslint-plugin": "7.16.0",
    "@typescript-eslint/parser": "7.16.0",
    "@vitejs/plugin-react": "4.3.1",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.35.0",
    "eslint-plugin-react-hooks": "4.6.2",
    "eslint-plugin-react-refresh": "0.4.7",
    "prettier": "3.3.3",
    "typescript": "5.5.3",
    "vite": "5.3.5"
  },
  "engines": {
    "node": ">=20.20.0"
  }
}
